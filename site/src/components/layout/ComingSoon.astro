---
// Placeholder state for a week sub-page whose content isn't authored yet.
import Icon from '@components/Icon.astro';
import type { IconName } from '@lib/icons';

interface Props {
  icon?: IconName;
  label: string;
  note?: string;
}

const { icon = 'sparkles', label, note } = Astro.props;
---

<div class="coming-soon">
  <Icon name={icon} size={36} />
  <p class="cs-label">{label}</p>
  {note && <p class="cs-note">{note}</p>}
</div>

<style>
  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-12) var(--space-6);
    border: 1px dashed var(--gray-300);
    border-radius: var(--radius-lg);
    color: var(--gray-500);
    text-align: center;
  }

  .cs-label {
    margin: 0;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .cs-note {
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>
