---
// Date-gate wrapper for a week's page content. If the week has `unlockOn` and
// the student's clock is before it, the slotted content is hidden behind an
// "Unlocks …" notice. The check runs client-side (applyLocks in SiteHeader's
// script, which is on every page); with JS off the content simply shows —
// this curtain is deliberately not security (see src/lib/unlock.ts).
import type { CollectionEntry } from 'astro:content';
import Icon from '@components/Icon.astro';
import { unlockLabel } from '@lib/unlock';

interface Props {
  week: CollectionEntry<'weeks'>;
}

const { week } = Astro.props;
const unlockOn = week.data.unlockOn;
---

{
  unlockOn ? (
    <div class="week-lock" data-unlock-on={unlockOn.toISOString()}>
      <div class="week-lock__notice">
        <span class="week-lock__icon">
          <Icon name="lock" size={28} />
        </span>
        <p class="week-lock__title">Not yet!</p>
        <p class="week-lock__when">Week {week.data.number} unlocks {unlockLabel(unlockOn)}.</p>
      </div>
      <div class="week-lock__content">
        <slot />
      </div>
    </div>
  ) : (
    <slot />
  )
}

<style>
  /* Unlocked (default, and no-JS): notice hidden, content untouched. */
  .week-lock__notice {
    display: none;
  }

  .week-lock.is-locked .week-lock__content {
    display: none;
  }

  /* Locked: the wrapper becomes the centering frame, so the notice lands in
   * the middle of whatever space the page gives it — the measure-width column
   * on lab/homework pages, the full dark stage on the slides page. */
  .week-lock.is-locked {
    display: grid;
    place-items: center;
    min-height: min(60vh, 26rem);
    padding: var(--space-8) var(--space-5);
  }

  .week-lock.is-locked .week-lock__notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    max-width: 30rem;
    padding: var(--space-8) var(--space-6);
    text-align: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }

  .week-lock__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand);
    margin-bottom: var(--space-1);
  }

  .week-lock__title {
    margin: 0;
    font-size: var(--fs-2xl);
    line-height: var(--lh-tight);
    font-weight: 700;
    color: var(--ink);
  }

  .week-lock__when {
    margin: 0;
    color: var(--ink-muted);
  }
</style>
