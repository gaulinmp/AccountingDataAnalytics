---
// Week overview: /week-NN/. Places the week in the course arc (description),
// lists the learning objectives, and links the five sub-pages.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { weekTabUrl, type WeekTab } from '@lib/url';
import Layout from '@layout/Layout.astro';
import SiteHeader from '@layout/SiteHeader.astro';
import WeekLock from '@layout/WeekLock.astro';
import Footer from '@layout/Footer.astro';
import Icon from '@components/Icon.astro';
import type { IconName } from '@lib/icons';
import { docsForWeek } from '@lib/labs';

export const getStaticPaths = (async () => {
  const weeks = await getCollection('weeks');
  return weeks.map((week) => ({ params: { week: week.id }, props: { week } }));
}) satisfies GetStaticPaths;

const { week } = Astro.props;

// Availability of each sub-page's content (drives the card hints).
const deck = (await getCollection('decks')).find((d) => d.data.week.id === week.id) ?? null;
const allLabs = await getCollection('labs');
const lab = docsForWeek(allLabs, week.data.number, 'Lab');
const homework = docsForWeek(allLabs, week.data.number, 'Homework');
const hasQuiz = (await getCollection('quizzes')).some((q) => q.id.startsWith(`w${week.data.number}-`));

const cards: { tab: WeekTab; label: string; icon: IconName; desc: string; ready: boolean; hint?: string }[] = [
  {
    tab: 'slides',
    label: 'Slides',
    icon: 'slides',
    desc: "The week's lecture deck, with inline self-checks.",
    ready: !!deck,
    hint: deck?.data.estMinutes ? `~${deck.data.estMinutes} min` : undefined,
  },
  { tab: 'activity', label: 'Activity', icon: 'puzzle', desc: 'An interactive, in-class exercise.', ready: false },
  { tab: 'lab', label: 'Lab', icon: 'flask', desc: 'Hands-on lab instructions and rubric.', ready: !!(lab.ug || lab.macc) },
  { tab: 'homework', label: 'Homework', icon: 'pencil', desc: 'Assignment instructions and rubric.', ready: !!(homework.ug || homework.macc) },
  { tab: 'quiz', label: 'Quiz', icon: 'helpCircle', desc: 'A self-check quiz on the material.', ready: hasQuiz },
];
---

<Layout title={`Week ${week.data.number}: ${week.data.title}`} description={week.data.summary}>
  <div class="week-page">
    <SiteHeader activeWeekId={week.id} activeTab="overview" />

    <main class="week-main">
      <header class="week-header">
        <p class="week-kicker">Week {week.data.number}</p>
        <h1>{week.data.title}</h1>
        {week.data.summary && <p class="week-summary">{week.data.summary}</p>}
      </header>

      <WeekLock week={week}>
      <div class="week-body">
        {week.data.description && (
          <section class="week-section">
            <h2>This week</h2>
            <p class="week-description">{week.data.description}</p>
          </section>
        )}

        {week.data.objectives && week.data.objectives.length > 0 && (
          <section class="week-section">
            <h2>Learning objectives</h2>
            <ul class="objectives-list">
              {week.data.objectives.map((obj) => (
                <li>{obj}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="week-section">
          <h2>Materials</h2>
          <ul class="cards">
            {cards.map((c) => (
              <li>
                <a href={weekTabUrl(week.id, c.tab)} class:list={['card', { 'is-pending': !c.ready }]}>
                  <span class="card__icon">
                    <Icon name={c.icon} size={22} />
                  </span>
                  <span class="card__text">
                    <span class="card__label">
                      {c.label}
                      {c.hint && <span class="card__hint">{c.hint}</span>}
                      {!c.ready && <span class="card__hint">coming soon</span>}
                    </span>
                    <span class="card__desc">{c.desc}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
      </WeekLock>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .week-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--surface);
  }

  .week-main {
    flex: 1;
    max-width: 46rem;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-8) var(--space-5) var(--space-12);
  }

  .week-header {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-6);
  }

  .week-kicker {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--brand);
  }

  .week-header h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-3xl);
    line-height: var(--lh-tight);
    color: var(--ink);
  }

  .week-summary {
    margin: 0;
    font-size: var(--fs-lg);
    color: var(--ink-muted);
  }

  .week-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .week-section h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-xl);
    color: var(--ink);
  }

  .week-description {
    margin: 0;
    color: var(--ink-muted);
    white-space: pre-line;
  }

  .objectives-list {
    margin: 0;
    padding-inline-start: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--ink-muted);
  }

  .objectives-list li {
    list-style-type: none;
  }

  .objectives-list li::before {
    content: '→';
    color: var(--brand);
    display: inline-block;
    width: 1.25em;
    margin-inline-start: -1.25em;
  }

  /* Sub-page cards */
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-3);
  }

  .card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    transition: border-color var(--transition), background var(--transition);
  }

  .card:hover {
    border-color: var(--brand);
    background: var(--brand-tint);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border-radius: var(--radius-md);
    background: var(--brand-tint);
    color: var(--brand);
  }

  .card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .card__label {
    font-weight: 600;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .card__hint {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--gray-500);
  }

  .card__desc {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .card.is-pending .card__icon {
    background: var(--surface-muted);
    color: var(--gray-500);
  }
</style>
