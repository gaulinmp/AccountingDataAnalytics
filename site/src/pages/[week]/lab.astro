---
// Weekly lab: /week-NN/lab/. Renders the instruction sheet(s) from the
// repo-level labs_hw/ tree (UG + optional MAcc variant) plus the grading
// rubric slot. See src/lib/labs.ts for the id contract.
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import WeekShell from '@layout/WeekShell.astro';
import ComingSoon from '@layout/ComingSoon.astro';
import InstructionDocs from '@layout/InstructionDocs.astro';
import { docsForWeek } from '@lib/labs';

export const getStaticPaths = (async () => {
  const weeks = await getCollection('weeks');
  return weeks.map((week) => ({ params: { week: week.id }, props: { week } }));
}) satisfies GetStaticPaths;

const { week } = Astro.props;
const docs = docsForWeek(await getCollection('labs'), week.data.number, 'Lab');
const ug = docs.ug ? await render(docs.ug) : null;
const macc = docs.macc ? await render(docs.macc) : null;
---

<WeekShell week={week} tab="lab" title="Lab" lede="Hands-on instructions for this week's lab." wide>
  {
    ug || macc ? (
      <InstructionDocs Ug={ug?.Content} Macc={macc?.Content} />
    ) : (
      <ComingSoon icon="flask" label="Lab instructions coming soon." note="This week's lab hasn't been posted yet." />
    )
  }

  <section class="rubric">
    <h2>Grading rubric</h2>
    <p class="rubric-empty">Rubric coming soon — what graders look for in this week's lab will be posted here.</p>
  </section>
</WeekShell>

<style>
  .rubric {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
  }

  .rubric h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-xl);
    color: var(--ink);
  }

  .rubric-empty {
    margin: 0;
    color: var(--gray-500);
    font-style: italic;
  }
</style>
